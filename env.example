# Application Settings
APP_NAME=Healthcare Appointment & Follow-up Manager
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security & JWT Auth
SECRET_KEY=change-this-to-a-super-secret-hex-key-for-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL=sqlite:///./healthcare.db

# LLM Providers Configuration (Gemini or OpenAI supported)
# LLM_PROVIDER can be 'gemini', 'openai', or 'mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# Email Service Configuration (SMTP / Mock)
# EMAIL_BACKEND can be 'console', 'mock', or 'smtp'
EMAIL_BACKEND=mock
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_or_smtp_password
SMTP_FROM_EMAIL=no-reply@clinicpulse.health
SMTP_FROM_NAME=ClinicPulse AI Health

# Google Calendar Integration
# Can use service account JSON or OAuth 2.0 Client credentials
GOOGLE_CALENDAR_ENABLED=True
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth2callback

# Background Scheduler & Slot Hold
SLOT_HOLD_TTL_MINUTES=5
MEDICATION_REMINDER_CHECK_INTERVAL_SECONDS=60
NOTIFICATION_RETRY_INTERVAL_SECONDS=120
MAX_NOTIFICATION_RETRIES=3
